# Model access. Two options:
#
#   1. Direct Anthropic API — set ANTHROPIC_API_KEY below.
#   2. OpenRouter (or any Anthropic-compatible endpoint) — set
#      ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN instead. OpenRouter serves
#      the Anthropic Messages API, so the SDK works unchanged; use OpenRouter
#      model slugs for MODEL_HAIKU / MODEL_OPUS / JUDGE_MODEL, e.g.
#        ANTHROPIC_BASE_URL=https://openrouter.ai/api
#        ANTHROPIC_AUTH_TOKEN=<key from https://openrouter.ai/keys>
#        MODEL_HAIKU=anthropic/claude-haiku-4.5
#        MODEL_OPUS=anthropic/claude-opus-4.8
#        JUDGE_MODEL=anthropic/claude-haiku-4.5
ANTHROPIC_API_KEY=

# Override the two models the chat-model experiment buckets sessions into,
# and/or the model used to judge conciseness/helpfulness.
# MODEL_HAIKU=claude-haiku-4-5
# MODEL_OPUS=claude-opus-4-8
# JUDGE_MODEL=claude-opus-4-8

# Point the SDK at any other Anthropic-compatible endpoint instead of the
# default Anthropic API.
# ANTHROPIC_BASE_URL=

# Set to 1 to run against the local Inngest Dev Server instead of Cloud.
# Both Next.js and the Bun worker auto-load this .env file.
INNGEST_DEV=1

# Inngest Cloud — required for production. Get these from app.inngest.com.
# Leave unset for local dev (INNGEST_DEV=1 above connects to the Dev Server).
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Identifies the deployed version of the app so Inngest can support rolling
# deploys. Use a git sha, build number, or image tag.
# INNGEST_APP_VERSION=

# Optional: unique per worker instance (defaults to hostname). Only matters
# once you're running more than one worker process.
# INNGEST_INSTANCE_ID=
