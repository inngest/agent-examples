# Runs against OpenRouter, A/B testing anthropic/claude-sonnet-5 vs
# nvidia/nemotron-3-ultra-550b-a55b by default (see "Model experiment &
# scoring" in the README). Get a key from https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Override the two models the chat-model experiment buckets sessions into
# (MODEL_A / MODEL_B), and/or the model used to judge conciseness/helpfulness
# (all OpenRouter slugs).
# MODEL_A=anthropic/claude-sonnet-5
# MODEL_B=nvidia/nemotron-3-ultra-550b-a55b
# JUDGE_MODEL=anthropic/claude-opus-4.8

# Each model's context window (tokens), used only to draw the UI context meter.
# Set these to match whatever you point MODEL_A / MODEL_B at; defaults below.
# MODEL_A_CONTEXT_WINDOW=1000000
# MODEL_B_CONTEXT_WINDOW=512000

# Per-response output cap (the API `max_tokens`). The UI context meter reserves
# this from each model's context window when drawing the usable-context bar.
# MAX_OUTPUT_TOKENS=11496

# Point the OpenAI SDK at a different OpenAI-compatible endpoint instead of
# OpenRouter's default (https://openrouter.ai/api/v1).
# OPENROUTER_BASE_URL=

# Optional: sent as the HTTP-Referer header for OpenRouter's app rankings.
# OPENROUTER_SITE_URL=

# Set to 1 to run against the local Inngest Dev Server instead of Cloud.
# Both Next.js and the Bun worker auto-load this .env file.
INNGEST_DEV=1

# Inngest Cloud — required for production. Get these from app.inngest.com.
# Leave unset for local dev (INNGEST_DEV=1 above connects to the Dev Server).
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Identifies the deployed version of the app so Inngest can support rolling
# deploys. Use a git sha, build number, or image tag.
# INNGEST_APP_VERSION=

# Optional: unique per worker instance (defaults to hostname). Only matters
# once you're running more than one worker process.
# INNGEST_INSTANCE_ID=
