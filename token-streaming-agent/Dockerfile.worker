# Bun Connect worker: runs the durable chat-agent function. Connect makes an
# outbound persistent connection to Inngest, so this needs no public ingress —
# a Render background worker (no port) is exactly right.
FROM oven/bun:1
WORKDIR /app

# Production deps only. inngest-cli is a devDependency (local Dev Server), so
# a production install also keeps it out of the image.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

# Bun runs TypeScript natively — no build step.
COPY src ./src
COPY tsconfig.json ./

# RENDER_GIT_COMMIT is provided by Render; use it as the app version for
# Inngest rolling deploys when INNGEST_APP_VERSION isn't set explicitly.
CMD ["sh", "-c", "INNGEST_APP_VERSION=${INNGEST_APP_VERSION:-$RENDER_GIT_COMMIT} exec bun src/worker/index.ts"]
