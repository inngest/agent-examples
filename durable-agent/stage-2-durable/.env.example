# Anthropic (model provider)
ANTHROPIC_API_KEY=
# Optional: point at any Anthropic-compatible endpoint + model
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=claude-opus-4-8

# Inngest Cloud — required for production. Get these from app.inngest.com.
# Leave unset for local dev (INNGEST_DEV=1 connects to the Dev Server instead).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Identifies the deployed version of the app. Use a git sha, build number,
# or image tag so Inngest can support rolling deploys.
INNGEST_APP_VERSION=

# Optional: unique per worker instance (defaults to hostname).
# INNGEST_INSTANCE_ID=

# Set to 1 to run against the local Inngest Dev Server instead of Cloud.
# INNGEST_DEV=1
