{
  "name": "durable-agent-stage-2",
  "version": "1.0.0",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "inngest": "INNGEST_DEV=1 npx inngest-cli@latest dev",
    "agent": "curl -s -w '\\n' -X POST localhost:${PORT:-3000}/api/agent -d '{\"prompt\": \"Charge my card $42\"}' | jq",
    "kill-switch:on": "curl -s -w '\\n' -X POST localhost:${PORT:-3000}/api/kill-switch -d '{\"enabled\": true}'",
    "kill-switch:off": "curl -s -w '\\n' -X POST localhost:${PORT:-3000}/api/kill-switch -d '{\"enabled\": false}'",
    "kill-switch:status": "curl -s -w '\\n' localhost:${PORT:-3000}/api/kill-switch"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "inngest": "^4.11.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
