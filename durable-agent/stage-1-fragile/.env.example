# Standard Anthropic SDK envs — both are read directly by the SDK client in
# src/agent.ts, so swapping providers never touches code.
ANTHROPIC_API_KEY=
# Point this at any Anthropic-compatible endpoint (e.g. MiniMax's Anthropic-
# compatible API) to swap providers. Leave unset to use api.anthropic.com.
ANTHROPIC_BASE_URL=
# Model id to request from whichever ANTHROPIC_BASE_URL is active.
ANTHROPIC_MODEL=

# Probability that each charge_credit_card attempt fails (0–1). Default 0.5.
# Set to 1 to force the failure every run, or 0 to always succeed.
# CHARGE_FAILURE_RATE=0.5

PORT=3000
