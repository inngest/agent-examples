{
  "name": "phase-2-eval-scoring",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "inngest": "INNGEST_DEV=1 npx inngest-cli@latest dev",
    "agent": "curl -s -w '\\n' -X POST localhost:${PORT:-3000}/api/chat -H 'content-type: application/json' -d '{\"prompt\": \"Explain recursion to a five-year-old.\"}' | jq",
    "populate": "bun run scripts/populate-scores.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@inngest/otel": "^0.2.2",
    "@opentelemetry/api": "^1.9.1",
    "hono": "^4.12.0",
    "inngest": "^4.13.0",
    "openai": "^7.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.8.0"
  }
}
