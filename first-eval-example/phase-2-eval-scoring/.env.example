# OpenRouter — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: any OpenAI-compatible endpoint. Defaults to OpenRouter.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model id the agent uses to answer.
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-haiku
#   google/gemini-2.0-flash-001
OPENROUTER_MODEL=

# HTTP port for the Hono app + readiness probe.
PORT=3000

# Set to 1 to connect to the local Inngest Dev Server instead of Inngest Cloud.
# The `bun run inngest` script already sets this for you.
# INNGEST_DEV=1

# Inngest Cloud — required for production (Connect needs both keys). Get these
# from app.inngest.com. Leave unset for local dev (INNGEST_DEV=1 connects to the
# Dev Server instead).
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# INNGEST_APP_VERSION=
# Optional: unique per Connect worker instance (defaults to hostname).
# INNGEST_INSTANCE_ID=

# Candidate model for the chat-model split experiment (control = OPENROUTER_MODEL)
# OPENROUTER_MODEL_CANDIDATE="anthropic/claude-3.5-haiku"
