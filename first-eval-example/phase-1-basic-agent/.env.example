# OpenRouter — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: any OpenAI-compatible endpoint. Defaults to OpenRouter.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model id to route through OpenRouter. A few cheap, fast options:
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-haiku
#   google/gemini-2.0-flash-001
# Leave unset and pass ?model= on the trigger instead, if you prefer.
OPENROUTER_MODEL=

# HTTP port for the Hono app.
PORT=3000

# Set to 1 to connect to the local Inngest Dev Server instead of Inngest Cloud.
# The `bun run inngest` script already sets this for you.
# INNGEST_DEV=1

# Inngest Cloud — required for production. Get these from app.inngest.com.
# Leave unset for local dev (INNGEST_DEV=1 connects to the Dev Server instead).
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# INNGEST_APP_VERSION=
