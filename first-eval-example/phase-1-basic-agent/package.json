{
  "name": "phase-1-basic-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "inngest": "INNGEST_DEV=1 npx inngest-cli@latest dev",
    "agent": "curl -s -w '\\n' -X POST localhost:${PORT:-3000}/api/agent -H 'content-type: application/json' -d '{\"prompt\": \"In one sentence, why is the sky blue?\"}' | jq"
  },
  "license": "ISC",
  "dependencies": {
    "hono": "^4.12.0",
    "inngest": "^4.13.0",
    "openai": "^7.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.8.0"
  }
}
