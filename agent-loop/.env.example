# OpenAI-compatible endpoint the agent calls (default: OpenRouter)
MODEL_BASE_URL=https://openrouter.ai/api/v1/
# Model the agent runs (OpenRouter slug). Overridable per goal via goal/started data.model.
MODEL=qwen/qwen3-coder-30b-a3b-instruct
# Optional OpenRouter provider preference, comma-separated and tried in order (e.g. Phala).
# Unset: the fastest provider that supports every parameter.
MODEL_PROVIDERS=
# API key for that endpoint (falls back to OPENROUTER_API_KEY)
MODEL_API_KEY=
# Use the local Inngest dev server (npx inngest-cli dev). Omit for Inngest Cloud.
INNGEST_DEV=1
# Where the agent's workspace lives and the check runs:
#   local   = git repo in workspace/, check in a child process (default)
#   sandbox = files in step state, typecheck on the worker, check in a fresh
#             Inngest Sandbox. Cloud only: unset INNGEST_DEV, set the keys below.
WORKSPACE_BACKEND=local
# Port for the express server (src/server.ts) / readiness probe (src/worker.ts)
PORT=3000
# Inngest Cloud only:
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# Connect worker (pnpm start:worker): set by the Dockerfile from RENDER_GIT_COMMIT
# INNGEST_APP_VERSION=
