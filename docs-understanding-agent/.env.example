# OpenRouter (model provider for the experiment variants + judge)
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# JUDGE_MODEL=google/gemini-2.0-flash-001

# GitHub App — required for the real webhook flow. Not needed with DRY_RUN_GITHUB=1.
GITHUB_APP_ID=
# PEM contents, or base64(PEM) if your env tooling dislikes newlines.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Which changed files count as docs content (comma-separated path prefixes).
# DOCS_PATH_PREFIXES=docs/,blog/,content/
# Prefix stripped from file paths before building the page route, e.g. "src/pages".
# DOCS_CONTENT_ROOT=
# Max pages analyzed per PR (bounds LLM cost).
# MAX_PAGES=5

# Vercel "Protection Bypass for Automation" secret, if the preview is protected.
# PREVIEW_BYPASS_SECRET=

# Stub out all GitHub API calls (demo mode; only OPENROUTER_API_KEY needed).
# DRY_RUN_GITHUB=1

# PORT=3000

# Inngest Cloud — required for production. Get these from app.inngest.com.
# Leave unset for local dev (INNGEST_DEV=1 connects to the Dev Server instead).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Identifies the deployed version of the app (git sha, build number, image tag).
INNGEST_APP_VERSION=

# Set to 1 to run against the local Inngest Dev Server instead of Cloud.
# INNGEST_DEV=1
