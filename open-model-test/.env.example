# MiniMax M3 on Nebius Token Factory — the v3 contender. Get a key at
# https://tokenfactory.nebius.com (OpenAI-compatible API). Referenced by
# config/benchmark.yaml via ${NEBIUS_BASE_URL}.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# OpenRouter — the Sonnet baseline still routes through it.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: any OpenAI-compatible endpoint. Defaults to OpenRouter.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# HTTP port for the Hono app + readiness probe.
PORT=3001

# Where the SQLite results store lives. Defaults to data/results.db
# relative to this directory (see src/db.ts).
# RESULTS_DB_PATH=data/results.db

# Set to 1 to connect to the local Inngest Dev Server instead of Inngest Cloud.
# The `bun run dev` script already sets this for you — only needed when using
# `bun run start` against the Dev Server.
# INNGEST_DEV=1

# Inngest Cloud — required for production (Connect needs both keys). Get these
# from app.inngest.com. Leave unset for local dev (INNGEST_DEV=1 connects to the
# Dev Server instead).
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
#   ^ also required for sandbox.runner: inngest (Sandboxes beta is cloud-only,
#     access-gated; 403 access_denied = ask Inngest to enable it for you).
# INNGEST_APP_VERSION=
# Optional: unique per Connect worker instance (defaults to hostname).
# INNGEST_INSTANCE_ID=
